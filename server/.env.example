# ---- server ----
PORT=8787
DB_PATH=./data/app.db
CORS_ORIGIN=http://localhost:5173

# ---- Google Places API (New) ----
# Leave blank to run in MOCK mode (synthetic leads, zero cost, fully usable UI)
GOOGLE_PLACES_API_KEY=
# enterprise = includes rating + userRatingCount (needed for the DEMAND score)
# pro        = drops rating fields, ~10% cheaper per call, DEMAND falls back to neutral
PLACES_FIELD_TIER=enterprise
PLACES_MAX_PAGES=3

# ---- Google PageSpeed Insights (free) ----
PAGESPEED_API_KEY=

# ---- Gemini ----
# Leave blank to run AI in MOCK mode (deterministic template output, no network)
GEMINI_API_KEY=
GEMINI_MODEL_FAST=gemini-2.5-flash-lite
GEMINI_MODEL_MAIN=gemini-2.5-flash
# free-tier safe defaults; raise these once billing is on
GEMINI_RPM=10
GEMINI_RPD=250
GEMINI_CONCURRENCY=1

# Search-grounded calls (research, verify, social): gemini-2.5-flash searches far more often
# LLM_MODEL_SEARCH=gemini-2.5-flash

# ---- Google Maps discovery ----
# Optional Luna + Gemini mode (docs/combined-discovery.md).
# OPENAI_API_KEY=
# MAPS_MCP_API_KEY=
# DISCOVERY_SOURCE=combined
# DISCOVERY_LUNA_MODEL=gpt-6-luna
# DISCOVERY_LUNA_EFFORT=max
# DISCOVERY_GEMINI_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash
# DISCOVERY_GEMINI_THINKING=medium
# DISCOVERY_GEMINI_TOOL=search
# DISCOVERY_MAPS_MCP=true
# DISCOVERY_RESULTS_PER_PASS=15
# DISCOVERY_MAX_OUTPUT_TOKENS=16000
# Luna retries; Gemini uses at most one final retry after trying its chain (0 disables it).
# DISCOVERY_RETRIES=2
# minimal = same businesses as the default thinking in a third of the time (gemini-3.x flash only)
# MAPS_THINKING_LEVEL=minimal
# MAPS_CONCURRENCY=4
# DISCOVERY_CATEGORY_CONCURRENCY=2

# ---- enrichment ----
# Google Maps lookup for each new OpenStreetMap lead (needs a working GEMINI_API_KEY)
MAPS_ENRICH_ON_DISCOVERY=true
MAPS_ENRICH_MAX_PER_RUN=200
# Instagram Business Discovery API (blank = search finds handles; reps paste counts from Google)
META_GRAPH_TOKEN=
INSTAGRAM_BUSINESS_ID=

# ---- background work and data cleanup ----
WORKER_CONCURRENCY=3
MAINTENANCE_AUTO=true
MAINTENANCE_INTERVAL_HOURS=24
