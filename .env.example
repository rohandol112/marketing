# ---------------------------------------------------------------------------
# One env for the whole all-in-one container. Paste into Coolify's env editor.
# Every value below is optional - with an empty file the app boots, seeds
# itself and runs discovery and AI in mock mode.
# ---------------------------------------------------------------------------

# The port inside the container. Coolify maps its proxy onto this.
PORT=8787

# Same origin serves the UI and the API, so CORS never comes into play. Only
# set this if something else calls the API cross-origin.
# CORS_ORIGIN=https://sales.example.com

# ---- the front door ----------------------------------------------------
# The app's own auth is a stub: an x-user-id header picks the acting user.
# On a public URL set a password and the whole thing sits behind one shared
# HTTP login. Leave it blank only if the deploy is behind a VPN or Coolify's
# own access control.
APP_USERNAME=dudeai
APP_PASSWORD=

# ---- database ----------------------------------------------------------
# Left alone, Postgres runs inside this container against the volume mounted
# at /var/lib/postgresql/data. Change the password before the first deploy -
# it is baked into the cluster on the very first boot and ignored after that.
POSTGRES_USER=dudeai
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dudeai

# Set this to a managed Postgres instead and the embedded one never starts.
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# ---- discovery ---------------------------------------------------------
# places | maps | osm | gemini | mock   (auto picks the best available)
DISCOVERY_SOURCE=auto

# Google Places API (New). Blank runs discovery in mock mode.
GOOGLE_PLACES_API_KEY=
# enterprise = rating + review count (the DEMAND score needs these)
# pro        = ~10% cheaper per call, DEMAND falls back to neutral
PLACES_FIELD_TIER=enterprise
PLACES_MAX_PAGES=3

# Google PageSpeed Insights, free, used by the website audit.
PAGESPEED_API_KEY=

# ---- LLM ---------------------------------------------------------------
# gemini | groq | ollama | openrouter   (blank = whichever key is present)
LLM_PROVIDER=gemini
LLM_MODEL_MAIN=gemini-2.5-flash
LLM_MODEL_FAST=gemini-2.5-flash-lite

# Blank runs the AI in mock mode: deterministic templates, no network calls.
GEMINI_API_KEY=
GEMINI_RPM=120
GEMINI_CONCURRENCY=4

# Open-weight alternatives - set one key and switch LLM_PROVIDER.
# GROQ_API_KEY=
# OLLAMA_URL=http://host.docker.internal:11434
# OPENROUTER_API_KEY=

# ---- rarely needed -----------------------------------------------------
# FORCE_SEED=false          # re-run the demo seed on next boot
# PG_POOL_MAX=20
# PG_MAX_CONNECTIONS=50
# PG_SHARED_BUFFERS=128MB
# VERBOSE_AUDIT=false
