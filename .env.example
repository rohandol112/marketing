# ---------------------------------------------------------------------------
# One env for the whole all-in-one container. Paste into Coolify's env editor.
# The app boots and seeds itself with every value below left blank, with one
# catch: the selected LLM provider needs its API key. Without it, AI drafts
# use deterministic templates. Discovery credentials are configured separately.
# ---------------------------------------------------------------------------

# The port inside the container. Coolify maps its proxy onto this.
PORT=8787

# Optional combined discovery; see docs/combined-discovery.md.
# OPENAI_API_KEY=
# MAPS_MCP_API_KEY=
# DISCOVERY_SOURCE=combined
# DISCOVERY_COMBINED_PASSES=1
# DISCOVERY_LUNA_MODEL=gpt-6-luna
# DISCOVERY_LUNA_EFFORT=max
# DISCOVERY_GEMINI_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite
# DISCOVERY_GEMINI_THINKING=medium
# DISCOVERY_GEMINI_TOOL=search
# DISCOVERY_MAPS_MCP=true
# DISCOVERY_RESULTS_PER_PASS=25
# DISCOVERY_MAX_OUTPUT_TOKENS=16000
# Luna retries; Gemini uses at most one delayed retry cascade (0 disables it).
# DISCOVERY_RETRIES=2

# Same origin serves the UI and the API, so CORS never comes into play. Only
# set this if something else calls the API cross-origin.
# CORS_ORIGIN=https://sales.example.com

# ---- the front door ----------------------------------------------------
# The app's own auth is a stub: an x-user-id header picks the acting user.
# On a public URL set a password and the whole thing sits behind one shared
# HTTP login. Leave it blank only if the deploy is behind a VPN or Coolify's
# own access control.
APP_USERNAME=dudeai
APP_PASSWORD=

# ---- database ----------------------------------------------------------
# Left alone, Postgres runs inside this container against the volume mounted
# at /var/lib/postgresql/data. Change the password before the first deploy -
# it is baked into the cluster on the very first boot and ignored after that.
POSTGRES_USER=dudeai
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dudeai

# Set this to a managed Postgres instead and the embedded one never starts.
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# ---- discovery ---------------------------------------------------------
# places | maps | osm | gemini | mock   (auto picks the best available)
DISCOVERY_SOURCE=auto

# Google Places API (New). Blank runs discovery in mock mode.
GOOGLE_PLACES_API_KEY=
# enterprise = rating + review count (the DEMAND score needs these)
# pro        = ~10% cheaper per call, DEMAND falls back to neutral
PLACES_FIELD_TIER=enterprise
PLACES_MAX_PAGES=3

# Google PageSpeed Insights, free, used by the website audit.
PAGESPEED_API_KEY=

# ---- LLM ---------------------------------------------------------------
# openai | gemini | groq | ollama | openrouter (blank = whichever key is present)
LLM_PROVIDER=openai
OPENAI_API_KEY=
LLM_MODEL_MAIN=gpt-6.1-terra
LLM_MODEL_FAST=gpt-6.1-terra
LLM_MODEL_SEARCH=gpt-6.1-terra
LLM_REASONING_EFFORT=low
LLM_RESEARCH_EFFORT=medium
# Optional output ceilings include reasoning tokens.
# LLM_MAX_OUTPUT_TOKENS=8192
# LLM_RESEARCH_MAX_OUTPUT_TOKENS=16000

# Blank runs the AI in mock mode: deterministic templates, no network calls.
# A Google AI Studio key from aistudio.google.com/apikey. The same key powers
# Maps discovery, the Google Maps lookup and social search below. The server
# checks it with Google at boot: a refused key is logged in plain words and the
# Gemini sources show as unavailable, with Google's reason, in the app.
GEMINI_API_KEY=
GEMINI_RPM=120
GEMINI_CONCURRENCY=4
# Research, verification and social presence use the selected provider's web
# search. Gemini discovery/Maps keep their own model and key settings.

# ---- Google Maps discovery speed ------------------------------------------
# Thinking level for Maps grounding on gemini-3.x flash. "minimal" returned the
# same businesses with the same values as the default in about a third of the
# time (17s a call instead of 45-70s). "default" leaves the model's own setting.
# MAPS_THINKING_LEVEL=minimal
# Maps calls in flight at once (sweeps and lookups share this), and categories
# swept side by side. Each category runs its searches in parallel.
# MAPS_CONCURRENCY=4
# DISCOVERY_CATEGORY_CONCURRENCY=2

# ---- enrichment ----------------------------------------------------------
# After an OpenStreetMap sweep, look each new lead up on Google Maps for its
# review count, rating, phone and trading status (one grounded call per lead,
# high-value categories first). Needs the Gemini key above.
MAPS_ENRICH_ON_DISCOVERY=true
MAPS_ENRICH_MAX_PER_RUN=200

# Instagram's own Business Discovery API: followers, posts and last post for
# any public business account, through your agency's Instagram business
# account. Without it, social search finds handles and Facebook/LinkedIn pages
# but rarely follower counts - a rep pastes the Instagram line from Google into
# the lead's Details tab instead (ten seconds a lead).
META_GRAPH_TOKEN=
INSTAGRAM_BUSINESS_ID=
# META_GRAPH_VERSION=v23.0

# ---- background work and data cleanup -------------------------------------
# Jobs run at once: audits and lookups mostly wait on the network.
WORKER_CONCURRENCY=3
# The cleanup (normalise, re-categorise, exclude, merge, housekeep, rescore)
# runs on its own this often. Preview it any time in Settings -> System.
MAINTENANCE_AUTO=true
MAINTENANCE_INTERVAL_HOURS=24
# How long things are kept, in days.
# JOB_RETENTION_DAYS=7
# FAILED_JOB_RETENTION_DAYS=30
# USAGE_RETENTION_DAYS=400
# AI_CACHE_RETENTION_DAYS=45
# REJECTED_LEAD_RETENTION_DAYS=60
# RUN_RETENTION_DAYS=30
# OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter

# Open-weight alternatives - set one key and switch LLM_PROVIDER.
# GROQ_API_KEY=
# OLLAMA_URL=http://host.docker.internal:11434
# OPENROUTER_API_KEY=

# ---- rarely needed -----------------------------------------------------
# FORCE_SEED=false          # re-run the demo seed on next boot
# PG_POOL_MAX=20
# PG_MAX_CONNECTIONS=50
# PG_SHARED_BUFFERS=128MB
# VERBOSE_AUDIT=false
